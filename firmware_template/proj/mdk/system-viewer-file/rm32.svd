        </register>
        <register>
          <name>TDR</name>
          <addressOffset>0x00000060</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <description>UART1 TX Data Register</description>
          <fields>
            <field>
              <name>NI</name>
              <msb>11</msb>
              <lsb>11</lsb>
              <access>read-write</access>
              <description>UART1 TDR NI Bit: Inject noise</description>
            </field>
            <field>
              <name>STOP2FEI</name>
              <msb>10</msb>
              <lsb>10</lsb>
              <access>read-write</access>
              <description>UART1 TDR STOP2FEI Bit: Inject frame error at stop bit 2</description>
            </field>
            <field>
              <name>STOP1FEI</name>
              <msb>9</msb>
              <lsb>9</lsb>
              <access>read-write</access>
              <description>UART1 TDR STOP1FEI Bit: Inject frame error at stop bit 1</description>
            </field>
            <field>
              <name>PEI</name>
              <msb>8</msb>
              <lsb>8</lsb>
              <access>read-write</access>
              <description>UART1 TDR PEI Bit: Inject parity error</description>
            </field>
            <field>
              <name>DATA</name>
              <msb>7</msb>
              <lsb>0</lsb>
              <access>read-write</access>
              <description>UART1 TDR DATA [7:0] Bits: Data</description>
            </field>
          </fields>
        </register>
        <register>
          <name>SR1</name>
          <addressOffset>0x00000080</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <description>UART1 Status Register 1</description>
          <fields>
            <field>
              <name>TXRDY</name>
              <msb>0</msb>
              <lsb>0</lsb>
              <access>read-only</access>
              <description>UART1 SR1 TXRDY Bit: TX data register empty flag</description>
            </field>
          </fields>
